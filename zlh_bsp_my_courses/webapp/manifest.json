{
  "_version": "1.60.0",
  "sap.app": {
    "id": "zlhbspmycourses",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.31.1",
      "toolsId": "974ce9a3-56e5-4ff9-aac6-671e19ea6a2d"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zlh_personal_growth/srvd/sap/zlh_personal_growth/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.14",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zlhbspmycourses.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "zlh_c_my_coursesList",
          "target": "zlh_c_my_coursesList"
        },
        {
          "pattern": "zlh_c_my_courses({key}):?query:",
          "name": "zlh_c_my_coursesObjectPage",
          "target": "zlh_c_my_coursesObjectPage"
        },
        {
          "pattern": "zlh_c_my_courses({key})/_materials({key2}):?query:",
          "name": "zlh_c_my_course_materialsObjectPage",
          "target": "zlh_c_my_course_materialsObjectPage"
        }
      ],
      "targets": {
        "zlh_c_my_coursesList": {
          "type": "Component",
          "id": "zlh_c_my_coursesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/zlh_c_my_courses",
              "variantManagement": "Page",
              "navigation": {
                "zlh_c_my_courses": {
                  "detail": {
                    "route": "zlh_c_my_coursesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "zlh_c_my_coursesObjectPage": {
          "type": "Component",
          "id": "zlh_c_my_coursesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/zlh_c_my_courses",
              "navigation": {
                "_materials": {
                  "detail": {
                    "route": "zlh_c_my_course_materialsObjectPage"
                  }
                }
              }
            }
          }
        },
        "zlh_c_my_course_materialsObjectPage": {
          "type": "Component",
          "id": "zlh_c_my_course_materialsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/zlh_c_my_courses/_materials"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
