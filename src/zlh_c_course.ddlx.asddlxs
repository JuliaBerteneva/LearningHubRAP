@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName:       'Course',
  typeNamePlural: 'Courses',
  title:          { type: #STANDARD, value: 'Name' }   
}
annotate entity zlh_c_course with
{
  @UI.facet: [
    {
         id:'Header',
         purpose: #HEADER,
         type: #FIELDGROUP_REFERENCE,
         targetQualifier: 'Header',
         label: 'Course'
    },
    {
         id:'Main',
         type: #FIELDGROUP_REFERENCE,
         position: 10,
         targetQualifier: 'Course',
         label: 'Main Information'
    },
    {
         id:'MaterialsData',
         type: #LINEITEM_REFERENCE,
         targetElement: '_materials',
         position: 20,
         label: 'Materials'
    },
    {
         id: 'AvgRatingHeader',
         purpose: #HEADER,
         type: #DATAPOINT_REFERENCE,
         targetQualifier: 'AverageRating',
         label: 'Rating' }
    ]
  @ UI: {
    lineItem: [
        { type: #FOR_ACTION, dataAction: 'assignMeToCourse', label: 'Assign Me', position: 10 },
        { type: #FOR_ACTION, dataAction: 'releaseCourse', label: 'Release Course', position: 10 }
      ],
    fieldGroup: [{ qualifier: 'Course',
                   position: 1 },
                 { type: #FOR_ACTION, dataAction: 'assignMeToCourse', label: 'Assign Me', position: 10 }],
    hidden: true }
  @UI.identification: [ {type: #FOR_ACTION, dataAction: 'assignMeToCourse', label: 'Assign Me' },
                        {type: #FOR_ACTION, dataAction: 'releaseCourse', label: 'Release Course' } ]
  CourseId;
  @ UI: {
    fieldGroup: [{ qualifier: 'Course',
                   position: 2 }]
    }
  CourseKey;
  @ UI: {
    lineItem: [{ position: 1,
                 label: 'Course Name'
                  }],
    fieldGroup: [{ qualifier: 'Course',
                   position: 3 },
                 { qualifier: 'Header',
                   position: 3 },
                 { qualifier : 'Name' }]
    }
  Name;
  @ UI: {
    lineItem: [{ position: 3,
    hidden: true,
                 label: 'Type'}],
    fieldGroup: [{ qualifier: 'Course',
                   position: 6 },
                 { qualifier: 'Header',
                   position: 1 }]
    }
  Type;
  @ UI: {
    lineItem: [{ position: 2,
                 hidden: true,
                 label: 'Skill Category'}],
    fieldGroup: [{ qualifier: 'Course',
                   position: 7 },
                 { qualifier: 'Header',
                   position: 2 }]
    }
  SkillCategory;
  @ UI: {
    lineItem: [{ label: 'Moderator',
                 hidden: true
                 }],
    fieldGroup: [{ qualifier: 'Course',
                   position: 4 }]
    }
  Moderator;
  @ UI: {
    lineItem: [{ position: 4,
                 label: 'Duration'
                 }],
    fieldGroup: [{ qualifier: 'Course',
                   position: 5 },
                 { qualifier: 'Header',
                   position: 5 }]
    }
  Duration;
  @ UI: {
    lineItem: [{ position: 5,
                 label: 'Course Released'
                   }],
    fieldGroup: [{ qualifier: 'Course',
                   position: 5 },
                 { qualifier: 'Header',
                   position: 4 }]
    }
  Released;
  @UI: {
    lineItem: [{ position: 6,
                 type: #AS_DATAPOINT,
                 label: 'Course Average Rating',
                 importance: #HIGH }],
    identification: [{ position: 10,
                 type: #AS_DATAPOINT,
                 label: 'Average Rating' }],
    fieldGroup: [{ qualifier: 'Course', position: 8 }],
    dataPoint: { title: 'Average Rating',
                 targetValue: 5,
                 visualization: #RATING }
  }
  AverageRating;
  @ UI: {
    hidden: true
    }
  ModeratorName;
  @ UI: {
    hidden: true
    }
  ChangedByName;
  @ UI: {
    hidden: true
    }
  CreatedByName;
  @ UI: {
    hidden: true
    }
  SkillCategoryDescription;
  @ UI: {
    hidden: true
    }
  TypeDescription;
  @ UI: {
    hidden: true
    }
  LocalCreatedAt;
  @ UI: {
    hidden: true
    }
  LocalCreatedBy;
  @ UI: {
    hidden: true
    }
  LocalLastChangedAt;
  @ UI: {
    hidden: true
    }
  LocalLastChangedBy;
  @ UI: {
    hidden: true
    }
  LastChangedAt;
}