sap.ui.define([                                                                                                                                                                                                                                                
    "sap/m/Dialog",                                                                                                                                                                                                                                            
    "sap/m/Button",                                                                                                                                                                                                                                            
    "sap/m/MessageBox",                                                                                                                                                                                                                                        
    "sap/m/ButtonType"                                                                                                                                                                                                                                         
], function (Dialog, Button, MessageBox, ButtonType) {                                                                                                                                                                                                         
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    function _getODataModel() {                                                                                                                                                                                                                                
        var Element = sap.ui.require("sap/ui/core/Element");                                                                                                                                                                                                   
        if (!Element || !Element.registry) {                                                                                                                                                                                                                   
            return undefined;                                                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
        var oFound;                                                                                                                                                                                                                                            
        Object.values(Element.registry.all()).some(function (el) {                                                                                                                                                                                             
            if (!el.getModel) { return false; }                                                                                                                                                                                                                
            var m = el.getModel();                                                                                                                                                                                                                             
            if (m && m.isA && m.isA("sap.ui.model.odata.v4.ODataModel")) {                                                                                                                                                                                     
                oFound = m;                                                                                                                                                                                                                                    
                return true;                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
            return false;                                                                                                                                                                                                                                      
        });                                                                                                                                                                                                                                                    
        return oFound;                                                                                                                                                                                                                                         
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
        uploadFromFile: function () {                                                                                                                                                                                                                          
            var oModel = /** @type {sap.ui.model.odata.v4.ODataModel} */ (_getODataModel());                                                                                                                                                                   
            if (!oModel) {                                                                                                                                                                                                                                     
                MessageBox.error("Cannot initialize upload: OData model not available.");                                                                                                                                                                      
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            sap.ui.require(["sap/ui/unified/FileUploader"], function (FileUploader) {                                                                                                                                                                          
                var oSelectedFile = null;                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                var oUploadButton = new Button({                                                                                                                                                                                                               
                    text: "Upload",                                                                                                                                                                                                                            
                    type: "Emphasized",                                                                                                                                                                                                                        
                    enabled: false,                                                                                                                                                                                                                            
                    press: function () {                                                                                                                                                                                                                       
                        if (!oSelectedFile) {                                                                                                                                                                                                                  
                            return;                                                                                                                                                                                                                            
                        }                                                                                                                                                                                                                                      
                        oUploadButton.setEnabled(false);                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                        var oReader = new FileReader();                                                                                                                                                                                                        
                        oReader.onload = function (e) {                                                                                                                                                                                                        
                            var sBase64 = e.target.result.split(",")[1];                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                            var oOperation = /** @type {sap.ui.model.odata.v4.ODataContextBinding} */ (                                                                                                                                                        
                                oModel.bindContext("/zlh_c_my_skills/com.sap.gateway.srvd.zlh_skills.v0001.UploadFromFile(...)")                                                                                                                               
                            );                                                                                                                                                                                                                                 
                            oOperation.setParameter("file_name", oSelectedFile.name);                                                                                                                                                                          
                            oOperation.setParameter("mime_type", oSelectedFile.type);                                                                                                                                                                          
                            oOperation.setParameter("attachment", sBase64);                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                            oOperation.execute()                                                                                                                                                                                                               
                                .then(function () {                                                                                                                                                                                                            
                                    oDialog.close();                                                                                                                                                                                                           
                                    MessageBox.success("File uploaded successfully.");                                                                                                                                                                         
                                })                                                                                                                                                                                                                             
                                .catch(function (oErr) {                                                                                                                                                                                                       
                                    oUploadButton.setEnabled(true);                                                                                                                                                                                            
                                    MessageBox.error(oErr && oErr.message ? oErr.message : "Upload failed.");                                                                                                                                                  
                                });                                                                                                                                                                                                                            
                        };                                                                                                                                                                                                                                     
                        oReader.readAsDataURL(oSelectedFile);                                                                                                                                                                                                  
                    }                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                var oFileUploader = new FileUploader({                                                                                                                                                                                                         
                    name: "fileUpload",                                                                                                                                                                                                                        
                    width: "100%",                                                                                                                                                                                                                             
                    placeholder: "Choose a file...",                                                                                                                                                                                                           
                    change: function (oChangeEvent) {                                                                                                                                                                                                          
                        oSelectedFile = oChangeEvent.getParameter("files")[0] || null;                                                                                                                                                                         
                        oUploadButton.setEnabled(!!oSelectedFile);                                                                                                                                                                                             
                    }                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                var oDialog = new Dialog({                                                                                                                                                                                                                     
                    title: "Upload File",                                                                                                                                                                                                                      
                    content: [oFileUploader],                                                                                                                                                                                                                  
                    beginButton: new Button({                                                                                                                                                                                                                  
                        text: "Cancel",                                                                                                                                                                                                                        
                        press: function () {                                                                                                                                                                                                                   
                            oDialog.close();                                                                                                                                                                                                                   
                        }                                                                                                                                                                                                                                      
                    }),                                                                                                                                                                                                                                        
                    endButton: oUploadButton,                                                                                                                                                                                                                  
                    afterClose: function () {                                                                                                                                                                                                                  
                        oDialog.destroy();                                                                                                                                                                                                                     
                    }                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                oDialog.open();                                                                                                                                                                                                                                
            });                                                                                                                                                                                                                                                
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               