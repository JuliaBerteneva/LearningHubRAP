@Metadata.layer: #CUSTOMER
@UI.lineItem: [{criticality: 'Criticality'}]
@UI.headerInfo: {
  typeName:       'My Courses',
  typeNamePlural: 'My Courses',
  title:          { type: #STANDARD, value: 'Name' }   
}
annotate entity zlh_c_my_courses with
{
  @UI.facet: [
    {    id: 'HeaderContainer',
         purpose: #HEADER,
         type: #COLLECTION },
    {
         id:'Header',
         type: #FIELDGROUP_REFERENCE,
         targetQualifier: 'CourseInfo',
         parentId: 'HeaderContainer',
         label: 'Course',
         position: 10
    },
    {    id: 'Percentage',
         purpose: #HEADER,
         type: #DATAPOINT_REFERENCE,
         targetQualifier: 'Percentage',
         parentId: 'HeaderContainer',
         label: 'Completeness',
         position: 20
    },
    {    id: 'Rating',
         purpose: #HEADER,
         type: #DATAPOINT_REFERENCE,
         targetQualifier: 'Rating',
         parentId: 'HeaderContainer',
         label: 'My Rating'
    },
    {
         id:'BookingData',
         type: #LINEITEM_REFERENCE,
         targetElement: '_materials',
         label: 'Materials'
    }]
  @UI.identification: [
    { type: #FOR_ACTION, dataAction: 'changeStatus', label: 'Change Status', position: 10 },
    { type: #FOR_ACTION, dataAction: 'deleteMe', label: 'Exclude Me from Course', position: 20 },
    { type: #FOR_ACTION, dataAction: 'submitRating', label: 'Submit Rating', position: 30 },
    { type: #FOR_ACTION, dataAction: 'sendEmailToModerator', label: 'Ask for Help', position: 40 }
  ]
  @UI.fieldGroup: [
    { qualifier: 'CourseInfo', position: 1 }
  ]
  @UI : { hidden: true}
  CourseId;
  @ UI: {
    lineItem: [{ position: 2,
                 importance: #HIGH }],
    fieldGroup: [{ qualifier: 'CourseInfo',
                   position: 2 }]}
  Name;
  @ UI: {
    lineItem: [{ position: 3,
                 importance: #HIGH }],
    fieldGroup: [{ qualifier: 'CourseInfo',
                   position: 3 }]}
  Duration;
  @ UI: {
    lineItem: [ { position: 4,
                 importance: #HIGH,
                 criticality: 'Criticality',
                 criticalityRepresentation : #WITHOUT_ICON } ],
    fieldGroup: [{ qualifier: 'CourseInfo',
                   position: 4,
                   importance: #HIGH,
                   criticality: 'Criticality',
                   criticalityRepresentation : #WITHOUT_ICON  }]}
  @EndUserText.label: 'Status'
  Status;
  @ UI: {
    lineItem: [{ position: 5,
               type: #AS_DATAPOINT,
               label: 'My Rating',
               importance: #HIGH }],
    identification: [{ position: 10,
                 type: #AS_DATAPOINT,
                 label: 'Rating' }],
    dataPoint: { title: 'Your Rating',
               targetValue: 5,
               visualization: #RATING }
  }
  Rating;
  @UI: {
    dataPoint: { visualization: #PROGRESS,
                 qualifier: 'Percentage',
                 targetValue: 100 },
    lineItem: [ { hidden: true } ],
    hidden: true
    }
  Percentage;
  @ UI: {
    lineItem: [ { hidden: true }]
     }
  Criticality;
}